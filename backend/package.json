{
  "name": "vcom-backend",
  "version": "1.0.0",
  "description": "VCOM backend with Express, Socket.IO, MongoDB, RabbitMQ",
  "main": "dist/app/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app/server.ts",
    "start": "node dist/app/server.js",
    "build": "tsc",
    "worker:messages": "ts-node src/workers/message-bulk.worker.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.8",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
